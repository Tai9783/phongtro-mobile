<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bo4goc_vien"
    android:padding="3dp"
    >

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgRoom"
        android:layout_width="140dp"
        android:layout_height="130dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/decriptionImage"
        app:shapeAppearanceOverlay="@style/bo4goc"
        android:src="@drawable/anhphongtro"
        android:scaleType="centerCrop"
        />
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/imgRoom"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="5dp"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/itemPhongTro_title"
        android:textStyle="bold"
        android:textSize="16sp"
        />
    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/imgRoom"
        app:layout_constraintTop_toBottomOf="@+id/txtTitle"
        android:textSize="15sp"
        android:layout_marginStart="5dp"
        android:text="@string/itemPhongTro_Price"
        android:layout_marginTop="15dp"
        android:textStyle="bold"
        android:textColor="#074EFF"/>

    <ImageView
        android:id="@+id/iconAdress"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:contentDescription="@string/decriptionImage"
        android:src="@drawable/addresss"
        android:layout_marginTop="10dp"
        android:layout_marginStart="2dp"
        app:tint="#6B7280"
        app:layout_constraintStart_toEndOf="@+id/imgRoom"
        app:layout_constraintTop_toBottomOf="@+id/txtPrice" />
    <TextView
        android:id="@+id/txtWard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/itemPhongTro_ward"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:layout_marginStart="1dp"
        app:layout_constraintStart_toEndOf="@+id/iconAdress"
        app:layout_constraintTop_toBottomOf="@+id/txtPrice"
        />
    <TextView
        android:id="@+id/txtCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_local_hcm"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:layout_marginStart="3dp"
        app:layout_constraintStart_toEndOf="@+id/txtWard"
        app:layout_constraintTop_toBottomOf="@+id/txtPrice"
        />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="8dp"
        app:cardElevation="0dp"
        android:gravity="center"
        app:cardBackgroundColor="#FFE4E4"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/icon_delete"
                app:tint="#EF4444"
                android:contentDescription="@string/decriptionImage"/>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/iconTime"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:layout_constraintStart_toEndOf="@+id/imgRoom"
        app:layout_constraintTop_toBottomOf="@+id/txtCity"
        android:layout_marginStart="3dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/decriptionImage"
        android:src="@drawable/icon_time"
        app:tint="#DB9711"/>
    <TextView
        android:id="@+id/txtTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/iconTime"
        app:layout_constraintTop_toBottomOf="@+id/txtCity"
        android:layout_marginStart="5dp"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:text="@string/MyPost_item_time"
        android:textColor="#D39006"/>
    <TextView
        android:id="@+id/txtTimee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/txtTime"
        app:layout_constraintTop_toBottomOf="@+id/txtCity"
        android:layout_marginStart="2dp"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:text="@string/MyPost_item_timee"
        android:textColor="#D39006"/>





</androidx.constraintlayout.widget.ConstraintLayout>